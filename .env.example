# ============================================================
# 時計価格ナビ 環境変数（このファイルを .env にコピーして値を入力）
# GitHub Actions で運用する場合は Settings > Secrets and variables に登録
# ============================================================

# --- 価格収集（サーバー側・秘密） -----------------------------

# 楽天ウェブサービスのアプリID（https://webservice.rakuten.co.jp/ で無料発行）
RAKUTEN_APP_ID=

# 楽天の新API基盤のアクセスキー（アプリID発行時に表示。旧APIは2026年8月に廃止のため必須）
RAKUTEN_ACCESS_KEY=

# 新API基盤が要求する Origin ヘッダの値。
# アプリ登録時の「許可サイト（allowed websites）」と完全に一致させること。
# 未設定の場合は NEXT_PUBLIC_SITE_URL を使う。
# ローカル実行時も localhost ではなく登録した公開URLを入れる（Nodeから明示送信するため）。
RAKUTEN_ORIGIN=

# 楽天アフィリエイトID（https://affiliate.rakuten.co.jp/ で無料発行）
# 設定すると価格リンクが自動的にアフィリエイトリンクになる
RAKUTEN_AFFILIATE_ID=

# 楽天の検索を腕時計ジャンルに絞るジャンルID（既定: 558929 = 腕時計）
# "off" にするとジャンル絞り込みなし
RAKUTEN_GENRE_ID=558929

# Yahoo!デベロッパーネットワークのClient ID（https://e.developer.yahoo.co.jp/ で無料発行）
YAHOO_APP_ID=

# バリューコマースの sid / pid（Yahoo!ショッピングのアフィリエイト用）
# 設定すると Yahoo! の商品URLがアフィリエイトリンクになる
VC_SID=
VC_PID=

# --- ブログ自動生成（任意） ----------------------------------

# Anthropic APIキー（https://console.anthropic.com/ で発行）
# 設定すると毎朝のブログ記事がAI執筆になり品質が大きく向上します（1記事あたり数円）
# 未設定の場合はカタログ情報からテンプレート記事を自動生成します（無料）
ANTHROPIC_API_KEY=

# 記事執筆に使うモデル（既定: claude-sonnet-5）
BLOG_MODEL=

# --- サイト表示（ビルド時に埋め込まれる・公開情報） ------------

# 公開URL（独自ドメイン or https://<ユーザー名>.github.io）
NEXT_PUBLIC_SITE_URL=https://example.com

# GitHub Pages のプロジェクトページで運用する場合のみサブパスを指定（例: /watch-price-navi）
NEXT_PUBLIC_BASE_PATH=

# Google AdSense のクライアントID（例: ca-pub-XXXXXXXXXXXXXXXX）承認後に設定
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense の広告ユニットID（数字のみ。記事内広告枠に使用。承認後に設定）
NEXT_PUBLIC_ADSENSE_SLOT=

# バリューコマース LinkSwitch の vc_pid（管理画面 > ツール > LinkSwitch で取得）
NEXT_PUBLIC_VC_PID=

# お問い合わせ用メールアドレス（サイトに表示される）
NEXT_PUBLIC_CONTACT_EMAIL=
